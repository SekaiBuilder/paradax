# Credenciales del Media Manager — copia este archivo a `.env.media` y rellena.
# NUNCA subas .env.media a git ni lo compartas.

# ── Meta (Instagram + Facebook) ────────────────────────────────────
# 1. Crea una app en https://developers.facebook.com (tipo Business)
# 2. Vincula tu cuenta de Instagram (Business/Creator) a tu página de Facebook
# 3. Genera un token de larga duración con permisos:
#    instagram_basic, instagram_content_publish, pages_show_list, pages_read_engagement
IG_USER_ID=
META_ACCESS_TOKEN=

# Facebook Page (opcional — para publicar también el video en la página)
FB_PAGE_ID=
FB_PAGE_TOKEN=

# ── TikTok ─────────────────────────────────────────────────────────
# 1. Crea una app en https://developers.tiktok.com
# 2. Solicita el scope `video.publish` (Content Posting API)
# 3. Completa el flujo OAuth para obtener el token del usuario
TIKTOK_ACCESS_TOKEN=

# ── Hosting del video para Instagram (URL pública requerida) ───────
# Comando que sube un mp4 y devuelve su URL pública, si usas un bucket:
#   ej: aws s3 cp {video} s3://mi-bucket/ && echo https://cdn.midominio.com/{nombre}
VIDEO_HOST_CMD=
